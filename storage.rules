rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function owner(){ return signedIn() && request.auth.uid == 'o6rMhcEyUXUstmb7ptClXSv8ejQ2'; }
    function active(){
      return owner() || (
        signedIn()
        && firestore.exists(/databases/(default)/documents/companies/arw2026/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/companies/arw2026/members/$(request.auth.uid)).data.active == true
      );
    }
    function allowedType(){
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/json'
        || request.resource.contentType == 'text/plain'
        || request.resource.contentType == 'text/csv'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }
    match /companies/arw2026/{all=**} {
      allow read: if active();
      allow create, update: if active() && request.resource.size < 15 * 1024 * 1024 && allowedType();
      allow delete: if owner();
    }
    match /{all=**} { allow read, write: if false; }
  }
}
