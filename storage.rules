rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function owner(){ return signedIn() && (request.auth.uid == 'o6rMhcEyUXUstmb7ptClXSv8ejQ2' || request.auth.token.email == 'shaniwaris80@gmail.com'); }
    function member(){ return signedIn() && firestore.exists(/databases/(default)/documents/companies/arw2026/members/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/companies/arw2026/members/$(request.auth.uid)).data.active == true; }
    match /companies/arw2026/{allPaths=**} {
      allow read: if owner() || member();
      allow create, update: if (owner() || member()) && request.resource.size < 15 * 1024 * 1024;
      allow delete: if owner();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
