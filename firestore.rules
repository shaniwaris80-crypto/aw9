rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function owner(){ return signedIn() && request.auth.uid == 'o6rMhcEyUXUstmb7ptClXSv8ejQ2'; }
    function member(){ return /databases/$(database)/documents/companies/arw2026/members/$(request.auth.uid); }
    function active(){ return owner() || (signedIn() && exists(member()) && get(member()).data.active == true); }
    function role(){ return owner() ? 'owner' : (active() ? get(member()).data.role : 'none'); }
    function manager(){ return owner() || role() in ['admin','manager']; }
    function billing(){ return manager() || role() == 'billing'; }
    function warehouse(){ return manager() || role() == 'warehouse'; }
    function delivery(){ return manager() || role() == 'delivery'; }
    function specialCollection(c){ return c in ['members','settings','audit','invoices','payments']; }

    match /companies/arw2026/members/{uid} {
      allow read: if owner() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if owner();
    }

    match /companies/arw2026/settings/{doc=**} {
      allow read: if active();
      allow create, update: if manager();
      allow delete: if owner();
    }

    match /companies/arw2026/audit/{id} {
      allow read: if manager();
      allow create: if active();
      allow update, delete: if false;
    }

    match /companies/arw2026/invoices/{id} {
      allow read: if active();
      allow create, update: if billing();
      allow delete: if billing() && resource.data.status == 'draft';
    }

    match /companies/arw2026/payments/{id} {
      allow read: if active();
      allow create: if billing();
      allow update: if manager();
      allow delete: if false;
    }

    match /companies/arw2026/{collection}/{doc=**} {
      allow read: if !specialCollection(collection) && active();
      allow create, update, delete: if !specialCollection(collection) && (
        manager()
        || (billing() && collection in ['clients','quotes','proformas','deliveryNotes','creditNotes','priceRules','communications','documents','closures','cashMovements','bankMovements','expenses'])
        || (warehouse() && collection in ['products','suppliers','purchases','supplierPayments','stockMovements','transfers','wastes','returns','inventoryCounts','containers'])
        || (delivery() && collection in ['orders','routes','deliveries'])
      );
    }

    match /{doc=**} { allow read, write: if false; }
  }
}
