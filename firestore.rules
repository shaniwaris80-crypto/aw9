rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function owner(){ return signedIn() && (request.auth.uid == 'o6rMhcEyUXUstmb7ptClXSv8ejQ2' || request.auth.token.email == 'shaniwaris80@gmail.com'); }
    function memberPath(){ return /databases/$(database)/documents/companies/arw2026/members/$(request.auth.uid); }
    function member(){ return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true; }
    function role(){ return owner() ? 'owner' : (member() ? get(memberPath()).data.role : 'none'); }
    function manager(){ return owner() || role() in ['admin','manager']; }
    function billing(){ return manager() || role() == 'billing'; }
    function warehouse(){ return manager() || role() == 'warehouse'; }
    function delivery(){ return manager() || role() == 'delivery'; }
    function active(){ return owner() || member(); }
    function special(c){ return c in ['members','settings','series','audit','invoices','payments','stockMoves','closures']; }

    match /companies/arw2026/members/{uid} { allow read: if owner() || (signedIn() && request.auth.uid == uid); allow create, update, delete: if owner(); }
    match /companies/arw2026/settings/{id} { allow read: if active(); allow write: if manager(); }
    match /companies/arw2026/series/{id} { allow read: if billing(); allow create: if manager(); allow update: if billing(); allow delete: if owner(); }
    match /companies/arw2026/audit/{id} { allow read: if manager(); allow create: if active(); allow update, delete: if false; }
    match /companies/arw2026/invoices/{id} {
      allow read: if billing(); allow create: if billing();
      allow update: if billing() && (resource.data.status == 'draft' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','voidReason','voidedAt','rectificationIds','paid','sentAt','updatedAt']));
      allow delete: if billing() && resource.data.status == 'draft';
    }
    match /companies/arw2026/payments/{id} { allow read, create: if billing(); allow update: if manager(); allow delete: if false; }
    match /companies/arw2026/stockMoves/{id} { allow read: if warehouse() || billing(); allow create: if warehouse() || billing(); allow update, delete: if manager(); }
    match /companies/arw2026/closures/{id} { allow read: if billing() || manager(); allow create: if manager(); allow update, delete: if owner(); }

    match /companies/arw2026/{collection}/{id} {
      allow read: if !special(collection) && active() && (
        manager()
        || (billing() && collection in ['clients','products','orders','quotes','proformas','deliveryNotes','priceHistory','expenses','routes','communications','notifications','suppliers','purchases','transfers','wastes','returns','inventoryCounts','containers','cashMovements','bankMovements'])
        || (warehouse() && collection in ['products','suppliers','purchases','orders','routes','transfers','wastes','returns','inventoryCounts','containers','notifications','priceHistory'])
        || (delivery() && collection in ['clients','products','orders','routes','deliveryNotes','communications','containers','notifications'])
      );
      allow create, update: if !special(collection) && active() && (
        manager()
        || (billing() && collection in ['clients','orders','quotes','proformas','deliveryNotes','priceHistory','expenses','routes','communications','notifications','cashMovements','bankMovements'])
        || (warehouse() && collection in ['products','suppliers','purchases','orders','routes','transfers','wastes','returns','inventoryCounts','containers','priceHistory'])
        || (delivery() && collection in ['orders','routes','deliveryNotes','communications','containers'])
      );
      allow delete: if !special(collection) && manager();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
